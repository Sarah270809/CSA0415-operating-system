
#include <stdio.h>

int main(void) {
    int nb, np, i, j, choice;
    int block[20], process[20], allocated[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);
    if (nb < 1 || nb > 20) return 1;

    printf("Enter block sizes:\n");
    for (i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);
    if (np < 1 || np > 20) return 1;

    printf("Enter process sizes:\n");
    for (i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("1.First Fit  2.Best Fit  3.Worst Fit\n");
    printf("Enter choice: ");
    scanf("%d", &choice);
    if (choice < 1 || choice > 3) return 1;

    for (i = 0; i < np; i++) allocated[i] = -1;

    for (i = 0; i < np; i++) {
        int selected = -1;

        for (j = 0; j < nb; j++) {
            if (block[j] >= process[i]) {
                if (selected == -1)
                    selected = j;
                else if (choice == 2 &&
                         block[j] < block[selected])
                    selected = j;
                else if (choice == 3 &&
                         block[j] > block[selected])
                    selected = j;

                if (choice == 1) break;
            }
        }

        if (selected != -1) {
            allocated[i] = selected;
            block[selected] -= process[i];
        }
    }

    printf("\nProcess\tSize\tBlock\n");
    for (i = 0; i < np; i++) {
        printf("P%d\t%d\t", i + 1, process[i]);
        if (allocated[i] == -1)
            printf("Not allocated\n");
        else
            printf("%d\n", allocated[i] + 1);
    }

    return 0;
}
