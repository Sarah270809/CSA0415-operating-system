#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int source, destination;
    char buffer[100];
    ssize_t bytesRead;

    source = open("source.txt", O_RDONLY);

    if (source == -1)
    {
        perror("Error opening source.txt");
        return 1;
    }

    destination = open("destination.txt",
                      O_WRONLY | O_CREAT | O_TRUNC,
                      0644);

    if (destination == -1)
    {
        perror("Error creating destination.txt");
        close(source);
        return 1;
    }

    while ((bytesRead = read(source, buffer, sizeof(buffer))) > 0)
    {
        if (write(destination, buffer, bytesRead) != bytesRead)
        {
            perror("Error writing to destination.txt");
            close(source);
            close(destination);
            return 1;
        }
    }

    if (bytesRead == -1)
    {
        perror("Error reading source.txt");
        close(source);
        close(destination);
        return 1;
    }

    close(source);
    close(destination);

    printf("File copied successfully.\n");

    return 0;
}
