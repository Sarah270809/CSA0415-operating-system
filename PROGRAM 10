
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>

struct message {
    long type;
    char text[100];
};

int main(void) {
    int msgid;
    pid_t pid;
    struct message msg;

    msgid = msgget(IPC_PRIVATE, IPC_CREAT | 0600);
    if (msgid == -1) {
        perror("msgget");
        return 1;
    }

    pid = fork();

    if (pid < 0) {
        perror("fork");
        msgctl(msgid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        if (msgrcv(msgid, &msg, sizeof(msg.text), 1, 0) == -1) {
            perror("msgrcv");
            exit(1);
        }

        printf("Child process received: %s\n", msg.text);
        exit(0);
    } else {
        msg.type = 1;
        strcpy(msg.text, "Hello from parent process!");

        printf("Parent process sent: %s\n", msg.text);

        if (msgsnd(msgid, &msg, strlen(msg.text) + 1, 0) == -1) {
            perror("msgsnd");
            wait(NULL);
            msgctl(msgid, IPC_RMID, NULL);
            return 1;
        }

        wait(NULL);

        if (msgctl(msgid, IPC_RMID, NULL) == -1) {
            perror("msgctl");
            return 1;
        }
    }

    return 0;
}
