
#include <stdio.h>

int main(void) {
    int n, i, time = 0, quantum, remaining;
    int at[20], bt[20], rt[20], ct[20], tat[20], wt[20];
    int visited[20] = {0}, queue[10000];
    int front = 0, rear = 0, idx;
    float total_wt = 0, total_tat = 0;

    printf("Enter number of processes (1-20): ");
    scanf("%d", &n);

    if (n < 1 || n > 20) {
        printf("Invalid number of processes.\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("Enter arrival time and burst time for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);

        if (at[i] < 0 || bt[i] <= 0) {
            printf("Invalid input.\n");
            return 1;
        }

        rt[i] = bt[i];
    }

    printf("Enter time quantum: ");
    scanf("%d", &quantum);

    if (quantum <= 0) {
        printf("Invalid time quantum.\n");
        return 1;
    }

    remaining = n;

    while (remaining > 0) {
        for (i = 0; i < n; i++) {
            if (!visited[i] && at[i] <= time) {
                queue[rear++] = i;
                visited[i] = 1;
            }
        }

        if (front == rear) {
            time++;
            continue;
        }

        idx = queue[front++];

        if (rt[idx] > quantum) {
            time += quantum;
            rt[idx] -= quantum;
        } else {
            time += rt[idx];
            rt[idx] = 0;
            ct[idx] = time;
            tat[idx] = ct[idx] - at[idx];
            wt[idx] = tat[idx] - bt[idx];
            total_wt += wt[idx];
            total_tat += tat[idx];
            remaining--;
        }

        for (i = 0; i < n; i++) {
            if (!visited[i] && at[i] <= time) {
                queue[rear++] = i;
                visited[i] = 1;
            }
        }

        if (rt[idx] > 0) {
            queue[rear++] = idx;
        }
    }

    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], ct[i], tat[i], wt[i]);
    }

    printf("Average Waiting Time = %.2f\n", total_wt / n);
    printf("Average Turnaround Time = %.2f\n", total_tat / n);

    return 0;
}
