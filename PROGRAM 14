
#include <stdio.h>
#include <string.h>

int main(void) {
    char files[20][30], name[30];
    int n = 0, choice, i, found;

    while (1) {
        printf("\n1.Create file  2.Search file");
        printf("\n3.Display files  4.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (n == 20) {
                printf("Directory is full\n");
                continue;
            }

            printf("Enter filename: ");
            scanf("%29s", name);
            found = 0;

            for (i = 0; i < n; i++)
                if (strcmp(files[i], name) == 0)
                    found = 1;

            if (found)
                printf("File already exists\n");
            else {
                strcpy(files[n++], name);
                printf("File created\n");
            }
        } else if (choice == 2) {
            printf("Enter filename to search: ");
            scanf("%29s", name);
            found = 0;

            for (i = 0; i < n; i++)
                if (strcmp(files[i], name) == 0)
                    found = 1;

            printf(found ? "File found\n" : "File not found\n");
        } else if (choice == 3) {
            printf("Files in directory:\n");
            for (i = 0; i < n; i++)
                printf("%s\n", files[i]);
            if (n == 0) printf("No files\n");
        } else if (choice == 4) {
            break;
        } else {
            printf("Invalid choice\n");
        }
    }

    return 0;
}
