
#include <stdio.h>
#include <string.h>

int main(void) {
    char users[10][20], files[10][10][30];
    int count[10] = {0};
    int nu = 0, choice, i, u, found;
    char uname[20], fname[30];

    while (1) {
        printf("\n1.Create user  2.Create file");
        printf("\n3.Display directory  4.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (nu == 10) {
                printf("Maximum users reached\n");
                continue;
            }

            printf("Enter username: ");
            scanf("%19s", uname);
            found = 0;

            for (i = 0; i < nu; i++)
                if (strcmp(users[i], uname) == 0)
                    found = 1;

            if (found)
                printf("User already exists\n");
            else {
                strcpy(users[nu], uname);
                count[nu] = 0;
                nu++;
                printf("User created\n");
            }
        } else if (choice == 2) {
            printf("Enter username: ");
            scanf("%19s", uname);
            u = -1;

            for (i = 0; i < nu; i++)
                if (strcmp(users[i], uname) == 0)
                    u = i;

            if (u == -1) {
                printf("User not found\n");
                continue;
            }

            if (count[u] == 10) {
                printf("Directory is full\n");
                continue;
            }

            printf("Enter filename: ");
            scanf("%29s", fname);
            found = 0;

            for (i = 0; i < count[u]; i++)
                if (strcmp(files[u][i], fname) == 0)
                    found = 1;

            if (found)
                printf("File already exists\n");
            else {
                strcpy(files[u][count[u]++], fname);
                printf("File created\n");
            }
        } else if (choice == 3) {
            for (i = 0; i < nu; i++) {
                int j;
                printf("\nUser: %s\n", users[i]);
                for (j = 0; j < count[i]; j++)
                    printf("  %s\n", files[i][j]);
                if (count[i] == 0)
                    printf("  No files\n");
            }
        } else if (choice == 4) {
            break;
        } else {
            printf("Invalid choice\n");
        }
    }

    return 0;
}
