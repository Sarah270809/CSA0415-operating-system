
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main(void) {
    int shmid;
    char *shared_data;
    pid_t pid;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0600);
    if (shmid == -1) {
        perror("shmget");
        return 1;
    }

    shared_data = (char *)shmat(shmid, NULL, 0);
    if (shared_data == (char *)-1) {
        perror("shmat");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    pid = fork();

    if (pid < 0) {
        perror("fork");
        shmdt(shared_data);
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        sleep(1);
        printf("Child process received: %s\n", shared_data);
        shmdt(shared_data);
        exit(0);
    } else {
        strcpy(shared_data, "Hello from parent process!");
        printf("Parent process wrote: %s\n", shared_data);

        wait(NULL);
        shmdt(shared_data);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}
